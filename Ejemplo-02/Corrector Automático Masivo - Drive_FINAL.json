        "jsCode": "for (const item of $input.all()) {\n  try {\n    const evaluation = JSON.parse(item.json.response);\n\n    item.json = {\n      estudiante: $('Google Drive Trigger').item.json.name.replace('.js', ''),\n      puntuacion: evaluation.puntuacion,\n      // Unimos los arrays en un solo texto para que quepan bien en una celda de Excel\n      positivos: evaluation.aspectos_positivos.join(\" | \"),\n      errores: evaluation.errores_detectados.join(\" | \"),\n      sugerencias: evaluation.sugerencias_mejora.join(\" | \"),\n      resumen: evaluation.feedback_final,\n      fecha: new Date().toLocaleDateString()\n    };\n  } catch (error) {\n    item.json.error = \"Error al procesar el feedback detallado\";\n  }\n}\nreturn $input.all();"
